{
  "schema_version": 2,
  "policy": {
    "fail_closed": true,
    "publishable_article_categories": [
      "TRANSFER",
      "INJURY",
      "SUSPENSION",
      "PRESS_CONFERENCE"
    ],
    "publishable_statuses": [
      "OFFICIAL",
      "COMPLETED"
    ],
    "_transfer_policy_note": "Fast trusted-source publishing: official first-party sources and explicitly trusted Tier-1 media may publish a clear, factual, fresh story without waiting for a second publisher. FotMob remains Tier-7 catch-up/discovery and never outranks Tier-1 sources. Rumours, speculation and unverified claims remain blocked.",
    "allow_here_we_go": false,
    "allow_non_official_confirmation": true,
    "official_first_party_sufficient": true,
    "require_corroboration_with_official": false,
    "minimum_independent_publishers": 1,
    "minimum_here_we_go_publishers": 2,
    "conflict_minimum_status": "AGREEMENT",
    "unknown_dates_are_stale": true,
    "unknown_entities_are_invalid": true,
    "generated_text_must_be_template_only": true,
    "require_source_url": true,
    "allow_elite_medical_transfer_confirmation": false,
    "elite_medical_transfer_statuses": [
      "AGREEMENT",
      "MEDICAL"
    ],
    "minimum_elite_medical_publishers": 2,
    "allow_structured_fotmob_completed_transfers": false,
    "fast_publish": {
      "enabled": true,
      "require_second_source": false,
      "tier_1": [
        "official.premier_league",
        "official.fpl",
        "club.arsenal",
        "club.aston-villa",
        "club.bournemouth",
        "club.brentford",
        "club.brighton",
        "club.burnley",
        "club.chelsea",
        "club.crystal-palace",
        "club.everton",
        "club.fulham",
        "club.leeds",
        "club.liverpool",
        "club.manchester-city",
        "club.manchester-united",
        "club.newcastle-united",
        "club.nottingham-forest",
        "club.sunderland",
        "club.tottenham-hotspur",
        "club.west-ham-united",
        "club.wolverhampton-wanderers"
      ],
      "tier_2": [
        "media.bbc",
        "media.sky-sports",
        "media.espn",
        "media.the-athletic"
      ],
      "tier_7_catchup": [
        "media.fotmob"
      ],
      "tier_7_never_outranks": true
    }
  },
  "thresholds": {
    "entity_certainty_min": 0.98,
    "event_certainty_min": 0.95,
    "sport_confidence_min": 0.9,
    "sport_independent_signals_min": 2,
    "source_reliability_min": 0.86,
    "conflict_source_reliability_min": 0.75,
    "fact_agreement_min": 1.0,
    "max_publication_age_hours": 72,
    "max_confirmation_age_hours": 24,
    "max_future_clock_skew_minutes": 15,
    "active_story_window_days": 45,
    "overall_confidence_min": 0.9,
    "progression_same_milestone_window_hours": 6,
    "max_event_age_hours": 72
  }
}
