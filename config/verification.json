    "live_environment_variable": "VERIFICATION_V2_LIVE",
    "live_required_value": "I_ACCEPT_STRICT_V2",
    "database_rebuild_environment_variable": "VERIFICATION_V2_ALLOW_DB_REBUILD",
    "database_rebuild_required_value": "I_ACCEPT_HISTORY_RESET"
