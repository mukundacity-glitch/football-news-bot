{
  "schema_version": 2,
  "policy": {
    "fail_closed": true,
    "publishable_article_categories": [
      "TRANSFER",
      "INJURY",
      "SUSPENSION",
      "PRESS_CONFERENCE"
    ],
    "publishable_statuses": [
      "OFFICIAL",
      "COMPLETED"
    ],
    "_transfer_policy_note": "TRANSFER keeps two separate fail-closed lanes: first-party OFFICIAL/COMPLETED claims render as CONFIRMED; approved tier-one TALKS/NEGOTIATION/BID reports may render as REPORTED from one source, while AGREEMENT/MEDICAL/HERE_WE_GO requires two independent approved publishers. INTEREST/RUMOUR and non-official OFFICIAL/COMPLETED claims never publish. Source citation appears on the card only.",
    "allow_reported_transfers": true,
    "reported_transfer_single_source_statuses": ["TALKS", "NEGOTIATION", "BID"],
    "reported_transfer_two_source_statuses": ["AGREEMENT", "MEDICAL", "HERE_WE_GO"],
    "reported_transfer_approved_sources": [
      "journalist.fabrizio_romano",
      "journalist.david_ornstein",
      "media.the_athletic",
      "media.bbc_sport",
      "media.sky_sports"
    ],
    "allow_here_we_go": true,
    "allow_non_official_confirmation": false,
    "official_first_party_sufficient": true,
    "require_corroboration_with_official": false,
    "minimum_independent_publishers": 2,
    "minimum_here_we_go_publishers": 2,
    "conflict_minimum_status": "AGREEMENT",
    "unknown_dates_are_stale": true,
    "unknown_entities_are_invalid": true,
    "generated_text_must_be_template_only": true,
    "require_source_url": true,
    "allow_elite_medical_transfer_confirmation": false,
    "elite_medical_transfer_statuses": [
      "AGREEMENT",
      "MEDICAL"
    ],
    "minimum_elite_medical_publishers": 2,
    "allow_structured_fotmob_completed_transfers": false
  },
  "thresholds": {
    "entity_certainty_min": 0.98,
    "event_certainty_min": 0.95,
    "sport_confidence_min": 0.9,
    "sport_independent_signals_min": 2,
    "source_reliability_min": 0.86,
    "conflict_source_reliability_min": 0.75,
    "fact_agreement_min": 1.0,
    "max_publication_age_hours": 72,
    "max_confirmation_age_hours": 72,
    "max_future_clock_skew_minutes": 15,
    "active_story_window_days": 45,
    "overall_confidence_min": 0.9,
    "progression_same_milestone_window_hours": 6,
    "max_event_age_hours": 72
  },
  "confidence": {
    "aggregation": "weighted_geometric_mean",
    "weights": {
      "source_reliability": 1.0,
      "entity_certainty": 1.4,
      "event_certainty": 1.2,
      "fact_agreement": 1.5,
      "temporal_consistency": 1.2,
      "cross_source_agreement": 1.0,
      "official_confirmation": 2.0,
      "league_validation": 1.5,
      "sport_validation": 1.5,
      "story_freshness": 1.0,
      "database_consistency": 1.5
    }
  },
  "source_reliability": {
    "factor_weights": {
      "historical_accuracy": 0.35,
      "official_status": 0.25,
      "false_positive_rate": 0.2,
      "correction_rate": 0.1,
      "verification_history": 0.1
    },
    "outcome_weights": {
      "officially_confirmed": 1.0,
      "contradicted": -1.5,
      "corrected": -0.75,
      "unresolved": 0.0
    },
    "default_prior_mean": 0.5,
    "default_prior_strength": 10.0,
    "verification_history_full_count": 50
  },
  "events": {
    "TRANSFER": {
      "required_facts": [
        "subject_id",
        "subject_name",
        "club_from_id",
        "club_from_name",
        "club_to_id",
        "club_to_name"
      ],
      "allowed_subject_types": [
        "PLAYER"
      ],
      "conflict_fields": [
        "subject_id",
        "club_from_id",
        "club_to_id",
        "transfer_kind"
      ],
      "material_fields": [
        "club_from_id",
        "club_to_id",
        "transfer_kind",
        "contract_length",
        "fee"
      ],
      "official_relation_fields": [
        "club_from_id",
        "club_to_id",
        "competition_id"
      ],
      "progressive_fields": []
    },
    "INJURY": {
      "required_facts": [
        "subject_id",
        "subject_name",
        "club_id",
        "club_name",
        "injury_status"
      ],
      "allowed_subject_types": [
        "PLAYER"
      ],
      "conflict_fields": [
        "subject_id",
        "club_id",
        "injury_status",
        "return_date"
      ],
      "material_fields": [
        "injury_status",
        "injury_type",
        "return_date"
      ],
      "official_relation_fields": [
        "club_id",
        "competition_id"
      ],
      "progressive_fields": [
        "injury_status",
        "injury_type",
        "return_date"
      ]
    },
    "SUSPENSION": {
      "required_facts": [
        "subject_id",
        "subject_name",
        "club_id",
        "club_name",
        "suspension_status"
      ],
      "allowed_subject_types": [
        "PLAYER",
        "MANAGER"
      ],
      "conflict_fields": [
        "subject_id",
        "club_id",
        "suspension_length"
      ],
      "material_fields": [
        "suspension_status",
        "suspension_length",
        "return_date"
      ],
      "official_relation_fields": [
        "club_id",
        "competition_id"
      ],
      "progressive_fields": [
        "suspension_status",
        "return_date"
      ]
    },
    "PRESS_CONFERENCE": {
      "_note": "Official-only, same bar as TRANSFER: only a first-party club/league source publishing or hosting the press conference (own site/video/transcript, or a verified official club account explicitly quoting it) may become authoritative. A journalist quoting the same presser is NOT sufficient -- see engine.py._configured_nonofficial_confirmation, which refuses non-official sources for this category exactly like TRANSFER.",
      "required_facts": [
        "subject_id",
        "subject_name",
        "club_id",
        "club_name",
        "quote_summary"
      ],
      "allowed_subject_types": [
        "MANAGER",
        "PLAYER"
      ],
      "conflict_fields": [
        "subject_id",
        "club_id",
        "quote_summary"
      ],
      "material_fields": [
        "quote_summary",
        "quote_topic"
      ],
      "official_relation_fields": [
        "club_id",
        "competition_id"
      ],
      "progressive_fields": []
    }
  },
  "status_order": [
    "UNKNOWN",
    "RUMOUR",
    "INTEREST",
    "TALKS",
    "NEGOTIATION",
    "BID",
    "AGREEMENT",
    "MEDICAL",
