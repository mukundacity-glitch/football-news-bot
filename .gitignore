# Python bytecode caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Runtime caches and generated verification artifacts
data/fpl_cache.json
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
data/verification.sqlite3
data/last_run_status.json
.cache/
.pytest_cache/

# Generated bot output (historical tracked files remain until a separate archive)
fpl_drafts/
queue/pending/*
!queue/pending/.gitkeep
queue/posted/*
!queue/posted/.gitkeep
queue/dryrun/
queue/debug/*.jsonl
queue/debug/rejected_latest.json
queue/debug/decisions_*.json

# Downloaded runtime image caches (regenerated on every run)
logos/
players/

